{
  "name": "promptfolio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Promptfolio: a shareable year recap of your Claude Code use. Scripts run on Node 18.3+; development needs Node 22.12+.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
